# Cấu hình thiệp cưới. Copy file này thành .env rồi điền giá trị.
# Các giá trị này sẽ hiện trong trình duyệt của khách, nên KHÔNG để mật khẩu hay token ở đây.

# URL Web App của Google Apps Script (kết thúc bằng /exec). Để trống thì form chưa gửi được.
APPS_SCRIPT_URL=

# Giờ khai tiệc cho đồng hồ đếm ngược (giờ Việt Nam).
WEDDING_TIME=2026-11-24T17:00:00+07:00

# Địa điểm hiển thị trên Google Maps.
MAP_QUERY=Trung tâm tiệc cưới CTM Palace, 131 Nguyễn Phong Sắc, Nghĩa Đô, Cầu Giấy, Hà Nội

# Nhạc nền. Ưu tiên MUSIC_FILE (file mp3 trong assets/, ví dụ assets/music.m4a hoặc .mp3) nếu có;
# nếu để trống thì phát từ YouTube theo MUSIC_YOUTUBE_ID. MUSIC_START = giây bắt đầu phát.
MUSIC_FILE=assets/music.m4a
MUSIC_YOUTUBE_ID=AWKUF7xhuIw
MUSIC_START=0
